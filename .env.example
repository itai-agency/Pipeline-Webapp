# Server
PORT=3000
NODE_ENV=development

# Frontend (Vercel) — URL del API en Render/Railway (sin barra final)
# VITE_API_BASE_URL=https://pipeline-api.onrender.com

# Opcional
# VITE_APP_BUILD_MARKER=embudo-v2

# CORS (API) — origen del dashboard en Vercel
# CORS_ALLOWED_ORIGINS=https://pipeline-xxx.vercel.app
# CORS_ALLOW_VERCEL_PREVIEWS=true

# Frontend — bypass temporal de login (solo dev; nunca en producción)
# VITE_DEV_BYPASS_AUTH=true
SYNC_API_SECRET=change-me-for-cron-sync

# Supabase (backend uses service role for writes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Meta Marketing API
META_ACCESS_TOKEN=your-meta-access-token
META_API_VERSION=v21.0

# Kommo (amoCRM) API
KOMMO_SUBDOMAIN=your-subdomain
KOMMO_ACCESS_TOKEN=your-kommo-long-lived-token
KOMMO_PIPELINE_ID=

# Client mapping: Kommo pipeline/status -> dashboard client (JSON)
# Example: {"12345":"HOGARES","67890":"INQ"}
KOMMO_CLIENT_MAP={}

# Map Kommo status_id -> funnel counts (JSON)
# Example: {"142":{"conversaciones":0,"mql":1,"sql":0,"citas":0,"firmas":0}}
KOMMO_STATUS_MAP={}

# Meta ad accounts (JSON array, optional override)
# META_ACCOUNTS=[{"client":"HOGARES","accountName":"...","accountId":"act_..."}]
